# Required for live model decisions and LLM-as-judge verification/evaluation.
OPENAI_API_KEY=

# Required for live public web search.
TAVILY_API_KEY=

OPENAI_MODEL=gpt-5-mini
OPENAI_JUDGE_MODEL=gpt-5-mini
MAX_STEPS=8
PYTHON_TIMEOUT_SECONDS=5
WEB_TIMEOUT_SECONDS=15
ALLOWED_HOSTS=127.0.0.1,localhost
ENABLE_API_DOCS=false

# Local benchmark inference (no API key or provider billing).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_JUDGE_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

# Set these to the current provider rates to make cost metrics non-zero and meaningful.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
TAVILY_COST_PER_CALL=0

# Optional paths (relative paths are resolved by the shell, so absolute paths are clearest).
# CHROMA_PATH=/absolute/path/to/chroma
# RUN_DIR=/absolute/path/to/runs
